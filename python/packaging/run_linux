#!/bin/bash
#
# Run the Python port from the current source.
#
#   python/packaging/run_linux [document.md] [args...]
#
# This is the tool for iterating on the code: it runs the working tree through
# the venv, exactly as `python -m marklens` does, and never the frozen bundle
# under dist/. Use packaging/build_linux when you want that instead.
#
# There is no build step here - that is the whole point of the port.

cd "$(dirname "$0")/.."

for venv in ".venv" "../.venv"; do
    if [ -x "$venv/bin/python" ]; then
        # Resolved, not "../.venv": Python's site module compares sys.prefix
        # against the path recorded in pyvenv.cfg as a string, so an unresolved
        # ".." in the interpreter's path makes it warn that the prefix is
        # unexpected - while pointing at the very same directory.
        venv=$(cd "$venv" && pwd -P)
        echo "Running the source from $venv"
        exec "$venv/bin/python" -m marklens "$@"
    fi
done

echo "No virtual environment at python/.venv or ../.venv"
echo "Create one, then: pip install -e \".[dev]\""
exit 1

# touched
