#!/bin/bash
#
# Run the Python port from the current source.
#
#   python/packaging/run_linux [document.md] [args...]
#
# This is the tool for iterating on the code: it runs the working tree, exactly
# as `python -m marklens` does, and never the frozen bundle under dist/. Use
# packaging/build_linux when you want that instead.
#
# There is no build step here - that is the whole point of the port.
#
# Which python that is was settled before this script started: the venv you
# activated, or the one VS Code activated in its terminal. Nothing here goes
# looking for a venv. A script that picks its own interpreter can pick a
# different one from the one you have been installing into, and the project
# keeps a single environment at the repository root precisely so that cannot
# happen. python/packaging/setup is what checks it.

cd "$(dirname "$0")/.."

if [ -z "$VIRTUAL_ENV" ]; then
    echo "No virtual environment is active."
    echo "Activate it, then run this again:"
    echo "    source .venv/bin/activate      # from the repository root"
    echo "Opening marklens-ports in VS Code activates it in new terminals."
    exit 1
fi

exec python -m marklens "$@"
