#!/bin/bash
#
# Build the Windows application bundle and installer for the Python port.
#
#   python/packaging/build_win              # build and package
#   python/packaging/build_win app          # build only, no installer
#   python/packaging/build_win installer    # the default, named explicitly
#   python/packaging/build_win help
#
# Produces:
#   python/dist/marklens-py/                        the PyInstaller bundle
#   python/installer/Marklens_Python_V<version>.exe
#
# Runs under Cygwin or Git Bash. Requires the project venv to be active
# (packaging/setup checks it) and Inno Setup 6 (https://jrsoftware.org/isdl.php)

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

mode="${1:-installer}"
case "$mode" in
    help)
        echo "build_win [app|installer]"
        echo "  app  build only, runnable from dist/ with packaging/run_win"
        echo "  installer  the above, plus the installer (default)"
        exit 0
        ;;
    app|installer) ;;
    *)
        echo "Unknown mode: $mode"
        echo "build_win [app|installer]"
        exit 1
        ;;
esac

#===============================================
# Setup the correct python environment
#===============================================
# The venv is yours to activate - from the shell, or by opening marklens-ports
# in VS Code, which activates it in new terminals. Nothing here goes looking for
# one: a script that picks its own interpreter can pick a different one from the
# one you have been installing into. python/packaging/setup is what checks it.
if [ -z "$VIRTUAL_ENV" ]; then
    echo "No virtual environment is active."
    echo "Activate it, then run this again:"
    echo "    source .venv/Scripts/activate      # from the repository root"
    exit 1
fi
echo "Using $VIRTUAL_ENV"

PYTHON=python
PYINSTALLER=pyinstaller

if ! command -v "$PYINSTALLER" >/dev/null 2>&1; then
    echo "pyinstaller is not installed in $VIRTUAL_ENV"
    echo "Run: packaging/setup"
    exit 1
fi

echo "Running build for $(uname -m) architecture"

#===============================================
# Clean-up
#===============================================
# build/ holds both the PyInstaller work directory and installer_version, which
# is regenerated below; removing the lot keeps a stale version out of the
# installer name.
rm -rf dist
rm -rf build

#===============================================
# Generate the version from the git commit count
#===============================================
# Writes python/build/installer_version, which both the spec file and the Inno
# Setup script read. --print also writes it, so this is one call, not two.
version=$("$PYTHON" ../tools/gen_version_build.py python --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating installer for version ${version}"

#===============================================
# Run pyinstaller
#===============================================
"$PYINSTALLER" -y packaging/marklens.spec
if [ $? -ne 0 ]; then
    echo "Running pyinstaller failed"
    exit 1
fi

if [ "$mode" = "app" ]; then
    echo "Built python/dist/marklens-py - run it with packaging/run_win"
    exit 0
fi

#===============================================
# Prepare installer path
#===============================================
# ISCC is a native Windows program, so it needs a Windows path. cygpath is
# present in both Cygwin and Git Bash.
installer_file=$(cygpath -w "$(pwd)/packaging/marklens-py.iss")
ISCC_PATH="C:/Program Files (x86)/Inno Setup 6/ISCC.exe"

if [ ! -f "$ISCC_PATH" ]; then
    echo "Inno Setup 6 not found at ${ISCC_PATH}"
    echo "Install it from https://jrsoftware.org/isdl.php"
    exit 1
fi

#===============================================
# You must install Inno Setup 6 to build the installer
#===============================================
# No /D argument: the script reads build/installer_version itself. Git Bash
# rewrites arguments that look like Unix paths and Cygwin does not, so a
# command-line define cannot be written to work in both shells.
"$ISCC_PATH" "$installer_file"
if [ $? -ne 0 ]; then
    echo "Creating the installer failed"
    exit 1
fi

echo "Installer created successfully: python/installer/Marklens_Python_V${version}.exe"
