#!/bin/zsh
#
# Build the macOS application bundle and a disk image or installer package for
# the Python port.
#
#   python/packaging/build_mac            # defaults to dmg
#   python/packaging/build_mac app        # build only, no disk image
#   python/packaging/build_mac dmg|pkg
#   python/packaging/build_mac help
#
# Produces:
#   python/dist/Marklens Python.app
#   python/Marklens_Python_V<version>.dmg   (or .pkg)
#
# Signing and notarisation are opt-in, because an unsigned build is perfectly
# usable locally and this repository is public - no Developer ID is baked in.
# Set them in the environment to enable:
#
#   export CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   export INSTALLER_IDENTITY="Developer ID Installer: Your Name (TEAMID)"
#   export NOTARY_PROFILE="notarytool-profile"
#
# CODESIGN_IDENTITY is also read by packaging/marklens.spec, so the app inside
# the image is signed as well as the image itself.
#
# Requires the project venv to be active (packaging/setup checks it) and,
# for the dmg format, create-dmg: brew install create-dmg

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

#===============================================
# Signing settings.
#===============================================
# Identity and notary profile live in one file outside every repository, so no
# Developer ID is baked into the source and there is a single place to edit it.
# Absent, the signing steps below detect the unset variables and the build goes
# unsigned - which is the right behaviour for anyone who is not the maintainer.
MACSIGN_ENV="${MACSIGN_ENV:-$HOME/.config/macsign.env}"
[[ -f "$MACSIGN_ENV" ]] && source "$MACSIGN_ENV"

if [[ $# == 0 ]]
then
    format="dmg"
elif [[ $# == 1 ]]
then
    if [[ "$1" == "help" ]]
    then
        echo "build_mac [app|dmg|pkg]"
        echo "  app  build only, runnable from dist/ with packaging/run_mac"
        echo "  dmg  the above, plus a disk image (default)"
        echo "  pkg  the above, plus a signed installer package"
        exit 0
    fi
    format="$1"
    if [[ $format != "app" && $format != "dmg" && $format != "pkg" ]]
    then
        echo "Unknown format: $format"
        echo "build_mac [app|dmg|pkg]"
        exit 1
    fi
else
    echo "build_mac [app|dmg|pkg]"
    exit 1
fi

#===============================================
# Setup the correct python environment
#===============================================
# The venv is yours to activate - from the shell, or by opening marklens-ports
# in VS Code, which activates it in new terminals. Nothing here goes looking for
# one: a script that picks its own interpreter can pick a different one from the
# one you have been installing into. python/packaging/setup is what checks it.
if [ -z "$VIRTUAL_ENV" ]; then
    echo "No virtual environment is active."
    echo "Activate it, then run this again:"
    echo "    source .venv/bin/activate      # from the repository root"
    exit 1
fi
echo "Using $VIRTUAL_ENV"

echo "Running build for `arch` architecture"

#===============================================
# Clean-up
#===============================================
# build/ holds both the PyInstaller work directory and installer_version, which
# is regenerated below; removing the lot keeps a stale version out of the
# image name.
rm -rf dist
rm -rf build

#===============================================
# Generate the version from the git commit count
#===============================================
# Writes python/build/installer_version, which the spec file reads. --print
# also writes it, so this is one call, not two.
version=$(python ../tools/gen_version_build.py python --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating installer for version ${version}"

#===============================================
# Run pyinstaller
#===============================================
pyinstaller -y packaging/marklens.spec
if [ $? -ne 0 ]; then
    echo "Running pyinstaller failed"
    exit 1
fi

# COLLECT leaves the plain bundle directory next to the .app; only the .app
# should end up in the image.
echo "Removing dist/marklens-py"
rm -rf dist/marklens-py

#===============================================
# Re-sign the WebEngine helper with its entitlements
#===============================================
# PyInstaller signs everything it collects with the hardened runtime and
# entitlements_file=None, so QtWebEngineProcess comes out hardened and entitled
# to nothing. V8 cannot then reserve executable memory and the helper dies with
# "V8 process OOM (Failed to reserve virtual memory for CodeRange)". That does
# not stop the app launching - the window opens, the toolbar works, and no
# document ever renders - so it survives every check that is not opening a file.
#
# Qt ships the exemptions the helper needs beside it. Re-signing the helper
# invalidates the seal of the framework containing it, and that invalidates the
# app's, so both are sealed again afterwards, innermost first.
if [[ -n "$CODESIGN_IDENTITY" ]]; then
    echo "Re-signing the WebEngine helper with its entitlements"
    app_path="dist/Marklens Python.app"
    webengine_fw="$app_path/Contents/Frameworks/PySide6/Qt/lib/QtWebEngineCore.framework"
    helper="$webengine_fw/Versions/A/Helpers/QtWebEngineProcess.app"
    entitlements="$helper/Contents/Resources/QtWebEngineProcess.entitlements"

    if [[ ! -f "$entitlements" ]]; then
        echo "Missing ${entitlements}"
        echo "Without it the helper is signed with no JIT exemption and no"
        echo "document will render."
        exit 1
    fi

    /usr/bin/codesign --force --timestamp --options runtime \
        --entitlements "$entitlements" \
        --sign "$CODESIGN_IDENTITY" "$helper" || exit 1
    /usr/bin/codesign --force --timestamp --options runtime \
        --sign "$CODESIGN_IDENTITY" "$webengine_fw" || exit 1
    /usr/bin/codesign --force --timestamp --options runtime \
        --sign "$CODESIGN_IDENTITY" "$app_path" || exit 1

    # Catches a broken seal here, where the message names the part that failed,
    # rather than at the notary service, which takes minutes to say less.
    if ! /usr/bin/codesign --verify --deep --strict "$app_path"; then
        echo "The re-signed bundle does not verify"
        exit 1
    fi
fi

if [[ $format == "app" ]]; then
    echo "Built dist/Marklens Python.app - run it with packaging/run_mac"
    exit 0
fi

#===============================================
# Create the format.
#===============================================
echo "Creating the ${format}"
installer_name="Marklens_Python_V${version}.${format}"
test -f $installer_name && rm $installer_name

if [[ $format == "dmg" ]]
then
    create-dmg \
        --volname "Marklens Python $version Install" \
        --window-pos 1 1 \
        --window-size 640 400 \
        --icon-size 110 \
        --icon "Marklens Python.app" 160 180 \
        --app-drop-link 460 180 \
        --hide-extension "Marklens Python.app" \
        --format ULFO \
        --volicon "../shared/icon-py.icns" \
        $installer_name \
        "dist/"
else
    if [[ -z "$INSTALLER_IDENTITY" ]]; then
        echo "INSTALLER_IDENTITY is not set - a pkg cannot be built unsigned"
        echo "Set it, or build a dmg instead: packaging/build_mac dmg"
        exit 1
    fi
    rm -rf packages
    mkdir packages
    pkgbuild --root ./dist \
        --identifier "solutions.ddj.marklens.py" \
        --version "${version}" \
        --install-location "/Applications" \
        packages/MarklensPython.pkg
    productbuild --package-path ./packages \
        --package packages/MarklensPython.pkg \
        --sign "$INSTALLER_IDENTITY" \
        $installer_name
fi
if [ $? -ne 0 ]; then
    echo "Creating the ${format} failed"
    exit 1
fi

#===============================================
# Sign, notarize and staple - all skipped when unconfigured.
#===============================================
if [[ -z "$CODESIGN_IDENTITY" ]]; then
    echo "CODESIGN_IDENTITY is not set - leaving ${installer_name} unsigned."
    echo "Gatekeeper will warn on first launch; right-click > Open to bypass."
    echo "Done creating ${installer_name}"
    exit 0
fi

if [[ $format == "dmg" ]]
then
    echo "Signing the ${format}"
    /usr/bin/codesign -s "$CODESIGN_IDENTITY" $installer_name
    if [ $? -ne 0 ]; then
        echo "Signing the ${format} failed"
        exit 1
    fi
fi

if [[ -z "$NOTARY_PROFILE" ]]; then
    echo "NOTARY_PROFILE is not set - skipping notarisation."
    echo "Done creating ${installer_name}"
    exit 0
fi

echo "Notarizing the ${format}"
# notarytool exits 0 when Apple answers, not when Apple approves: a rejected
# submission still returns success and prints "status: Invalid". Checking only
# the exit status therefore carries on to stapling, which fails with a CloudKit
# "Record not found" that says nothing about the real problem. The verdict is
# read out of the output instead, and the log - which names the offending
# binaries - is fetched before giving up.
notary_output=$(xcrun notarytool submit $installer_name --wait --keychain-profile "$NOTARY_PROFILE" 2>&1)
notary_status=$?
echo "$notary_output"
if [ $notary_status -ne 0 ]; then
    echo "Notarizing the ${format} failed"
    exit 1
fi
if ! echo "$notary_output" | grep -q "status: Accepted"; then
    echo "Notarisation did not succeed - fetching the log"
    submission_id=$(echo "$notary_output" | awk '/id: /{print $2; exit}')
    if [[ -n "$submission_id" ]]; then
        xcrun notarytool log "$submission_id" --keychain-profile "$NOTARY_PROFILE"
    fi
    exit 1
fi

echo "Stapling the ${format}"
xcrun stapler staple $installer_name
if [ $? -ne 0 ]; then
    echo "Stapling the ${format} failed"
    exit 1
fi

echo "Done creating ${installer_name}"
