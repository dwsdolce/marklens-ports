#!/bin/bash
#
# Run the Python port from the current source.
#
#   python/packaging/run_win [document.md] [args...]
#
# This is the tool for iterating on the code: it runs the working tree through
# the venv, exactly as `python -m marklens` does, and never the frozen bundle
# under dist/. Use packaging/build_win when you want that instead.
#
# There is no build step here - that is the whole point of the port.

cd "$(dirname "$0")/.."

for venv in ".venv" "../.venv"; do
    if [ -x "$venv/Scripts/python.exe" ]; then
        echo "Running the source from $venv"
        exec "$venv/Scripts/python.exe" -m marklens "$@"
    fi
done

echo "No virtual environment at python/.venv or ../.venv"
echo "Create one, then: pip install -e \".[dev]\""
exit 1
