#!/bin/bash
#
# Build the Linux application bundle and its packages for the Python port.
#
#   python/packaging/build_linux                  # all three packages
#   python/packaging/build_linux app              # build only, no packages
#   python/packaging/build_linux appimage         # one format, named explicitly
#   python/packaging/build_linux deb,rpm          # or several
#   python/packaging/build_linux help
#
# Produces:
#   python/dist/marklens-py/                              the PyInstaller bundle
#   python/dist/Marklens-Python-<version>-<arch>.AppImage
#   python/dist/Marklens-Python-<version>-<arch>.deb
#   python/dist/Marklens-Python-<version>-<arch>.rpm
#
# The .deb and .rpm install the PyInstaller bundle under /opt - see
# packaging/make_linux_package, which the C++ port shares.
#
# Requires the project venv to be active and appimagetool. packaging/setup
# checks the first and downloads the second into packaging/tools/ at the
# repository root; set APPIMAGETOOL to use a copy of your own instead.

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

usage() {
    echo "build_linux [app|appimage|deb|rpm]"
    echo "  app  build only, runnable from dist/ with packaging/run_linux"
    echo "  the rest are package formats, comma-separated;"
    echo "  the default is appimage,deb,rpm"
}

mode="${1:-appimage,deb,rpm}"
case "$mode" in
    help) usage; exit 0 ;;
    app) ;;
    *)
        # Validated up front: a typo should not be discovered after PyInstaller
        # has spent a minute collecting Qt.
        for fmt in ${mode//,/ }; do
            case "$fmt" in
                appimage|deb|rpm) ;;
                *) echo "Unknown format: $fmt"; usage; exit 1 ;;
            esac
        done
        ;;
esac
want() { case ",$mode," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }

#===============================================
# Setup the correct python environment
#===============================================
# The venv is yours to activate - from the shell, or by opening marklens-ports
# in VS Code, which activates it in new terminals. Nothing here goes looking for
# one: a script that picks its own interpreter can pick a different one from the
# one you have been installing into. python/packaging/setup is what checks it.
if [ -z "$VIRTUAL_ENV" ]; then
    echo "No virtual environment is active."
    echo "Activate it, then run this again:"
    echo "    source .venv/bin/activate      # from the repository root"
    exit 1
fi
echo "Using $VIRTUAL_ENV"

echo "Running build for `uname -m` architecture"

#===============================================
# Clean-up
#===============================================
# build/ holds both the PyInstaller work directory and installer_version, which
# is regenerated below; removing the lot keeps a stale version out of the
# AppImage name.
rm -rf dist
rm -rf build

#===============================================
# Generate the version from the git commit count
#===============================================
# Writes python/build/installer_version, which the spec file reads. --print
# also writes it, so this is one call, not two.
VERSION=$(python ../tools/gen_version_build.py python --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating AppImage for version ${VERSION}"

#===============================================
# Run pyinstaller
#===============================================
pyinstaller -y packaging/marklens.spec
if [ $? -ne 0 ]; then
    echo "Running pyinstaller failed"
    exit 1
fi

#===============================================
# Drop the Qt plugins that cannot load
#===============================================
# PyInstaller's PySide6 hook collects every plugin type the shipped Qt
# libraries reference, and the wheel ships all of Qt. packaging/marklens.spec
# explains why excluding them there does not work - the hook puts them back -
# but removing them from the finished bundle does.
#
# Every one of these is backed by a library the wheel does not carry, so it
# could not load on any machine, and none of them is anything a Markdown viewer
# would ask for. They were the "objects have unresolved libraries" the .deb's
# dependency scan reported, and about 3 MB of a bundle that ships them.
#
# libqtiff is the one with a visible consequence: it wants libtiff.so.5, and
# current distributions ship libtiff.so.6, whose soname is deliberately
# different because the ABI changed. So TIFF images have not rendered for some
# time. Nothing here can fix that - the wheel bundles no libtiff of its own,
# and a .so.5 symlink onto .so.6 would be an ABI lie - and the C++ port ships
# no TIFF plugin at all, so dropping it makes the two ports agree rather than
# shipping a plugin that fails. Every other image format plugin resolves.
QT_BUNDLE=dist/marklens-py/_internal/PySide6/Qt
for dead in \
    plugins/sqldrivers \
    plugins/designer \
    plugins/egldeviceintegrations \
    plugins/imageformats/libqtiff.so \
    qml/QtWayland \
    qml/QtQuick/Shapes/DesignHelpers
do
    if [ -e "$QT_BUNDLE/$dead" ]; then
        echo "  dropping unloadable $dead"
        rm -rf "${QT_BUNDLE:?}/$dead"
    fi
done

if [ "$mode" = "app" ]; then
    echo "Built python/dist/marklens-py - run it with packaging/run_linux"
    exit 0
fi

ARCH=$(uname -m)

#===============================================
# Licences
#===============================================
# Into the PyInstaller bundle itself, which is both the AppImage's payload and
# the packages', so one copy reaches all three.
#
# PyInstaller collects no licence files - it has no idea which distribution
# package anything came from, the way linuxdeploy does for the C++ port - and
# the PySide6 wheels carry no licence text either, only a License field in
# their metadata. So without this the Python packages shipped Qt with nothing
# at all, which is the same hole the C++ warnings were pointing at, minus the
# warnings.
PYSIDE_VERSION=$(python -c \
    "from importlib.metadata import version; print(version('PySide6'))" 2>/dev/null)
../packaging/collect_licenses \
    "dist/marklens-py/share/doc/marklens-py" \
    "Marklens (Python/PySide6 port)" \
    "Qt 6 by way of PySide6${PYSIDE_VERSION:+ }$PYSIDE_VERSION, linked
dynamically and bundled into this package by PyInstaller, along with the Qt
plugins and the QtWebEngine resources. QtWebEngine carries its own copy of
Chromium, which is covered by Qt's licensing. The Python runtime is bundled
too, under the Python Software Foundation License."
if [ $? -ne 0 ]; then
    echo "Collecting the licences failed"
    exit 1
fi

#===============================================
# Assemble AppDir and build the AppImage
#===============================================
# Only for the AppImage. The .deb and .rpm are built straight from the
# PyInstaller bundle below, so when neither an AppImage nor an AppDir is wanted
# there is no reason to copy the bundle a second time.
if want appimage; then
    APPDIR=dist/AppDir
    rm -rf "$APPDIR"
    mkdir -p "$APPDIR/usr/bin" \
             "$APPDIR/usr/share/applications" \
             "$APPDIR/usr/share/icons/hicolor/512x512/apps"

    # Payload: the PyInstaller bundle directory.
    cp -r dist/marklens-py "$APPDIR/usr/bin/"

    # Desktop entry - appimagetool requires it at both the AppDir root and
    # usr/share/applications.
    cp packaging/marklens-py.desktop "$APPDIR/"
    cp packaging/marklens-py.desktop "$APPDIR/usr/share/applications/"

    # Icon - at the AppDir root under the name the desktop entry's Icon= field
    # uses, and again in the hicolor theme.
    ICON=../shared/icon-py.png
    cp "$ICON" "$APPDIR/marklens-py.png"
    cp "$ICON" "$APPDIR/usr/share/icons/hicolor/512x512/apps/marklens-py.png"

    # AppRun launcher.
    cp packaging/AppRun "$APPDIR/AppRun"
    chmod +x "$APPDIR/AppRun"

    # $APPIMAGETOOL first, then PATH, then ~/bin, then packaging/tools at the
    # repository root - the same four places, in the same order, that
    # packaging/setup looks in, so a tool setup reported as "ok" is a tool this
    # script can find. packaging/tools is where setup puts it when it downloads
    # it itself; a copy at ~/bin still wins.
    if [ -z "$APPIMAGETOOL" ]; then
        if command -v appimagetool >/dev/null 2>&1; then
            APPIMAGETOOL=$(command -v appimagetool)
        elif [ -x "$HOME/bin/appimagetool" ]; then
            APPIMAGETOOL="$HOME/bin/appimagetool"
        else
            APPIMAGETOOL="$(cd .. && pwd -P)/packaging/tools/appimagetool"
        fi
    fi
    if [ ! -x "$APPIMAGETOOL" ]; then
        echo "appimagetool not found at $APPIMAGETOOL"
        echo "Looked at \$APPIMAGETOOL, on PATH, in ~/bin, then packaging/tools/."
        echo
        echo "Run packaging/setup - it downloads it into packaging/tools/."
        echo "Or set APPIMAGETOOL=/path/to/appimagetool to use a copy of your own."
        exit 1
    fi

    OUT="dist/Marklens-Python-${VERSION}-${ARCH}.AppImage"
    ARCH=$ARCH "$APPIMAGETOOL" "$APPDIR" "$OUT"
    if [ $? -ne 0 ]; then
        echo "appimagetool failed"
        exit 1
    fi
    echo "Built $OUT"
fi

#===============================================
# .deb and .rpm
#===============================================
# PyInstaller has already produced a directory that runs in place, carrying its
# own Python and Qt, so it is the payload as it stands - no AppDir in between.
# The AppImage's AppRun is not carried over either: a package installs a
# wrapper in /usr/bin instead. See packaging/make_linux_package.
pkg_formats=""
want deb && pkg_formats="deb"
want rpm && pkg_formats="${pkg_formats:+$pkg_formats,}rpm"

if [ -n "$pkg_formats" ]; then
    ../packaging/make_linux_package \
        --name marklens-py \
        --stem Marklens-Python \
        --version "$VERSION" \
        --payload dist/marklens-py \
        --binary marklens-py \
        --desktop packaging/marklens-py.desktop \
        --icon ../shared/icon-py.png \
        --summary "A fast Markdown viewer" \
        --description "Marklens renders Markdown with syntax highlighting, Mermaid diagrams and live reload on change. This is the Python/PySide6 port, one of three implementations of the same viewer kept behaviourally identical by a shared specification." \
        --outdir dist \
        --formats "$pkg_formats"
    if [ $? -ne 0 ]; then
        echo "Building the packages failed"
        exit 1
    fi
fi
