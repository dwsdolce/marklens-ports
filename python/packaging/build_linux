#!/bin/bash
#
# Build the Linux application bundle and an AppImage for the Python port.
#
#   python/packaging/build_linux            # build and package
#   python/packaging/build_linux app        # build only, no AppImage
#   python/packaging/build_linux appimage   # the default, named explicitly
#   python/packaging/build_linux help
#
# Produces:
#   python/dist/marklens-py/                              the PyInstaller bundle
#   python/dist/Marklens-Python-<version>-<arch>.AppImage
#
# Requires the project venv to be active and appimagetool. packaging/setup
# checks the first and downloads the second into packaging/tools/ at the
# repository root; set APPIMAGETOOL to use a copy of your own instead.

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

mode="${1:-appimage}"
case "$mode" in
    help)
        echo "build_linux [app|appimage]"
        echo "  app  build only, runnable from dist/ with packaging/run_linux"
        echo "  appimage  the above, plus an AppImage (default)"
        exit 0
        ;;
    app|appimage) ;;
    *)
        echo "Unknown mode: $mode"
        echo "build_linux [app|appimage]"
        exit 1
        ;;
esac

#===============================================
# Setup the correct python environment
#===============================================
# The venv is yours to activate - from the shell, or by opening marklens-ports
# in VS Code, which activates it in new terminals. Nothing here goes looking for
# one: a script that picks its own interpreter can pick a different one from the
# one you have been installing into. python/packaging/setup is what checks it.
if [ -z "$VIRTUAL_ENV" ]; then
    echo "No virtual environment is active."
    echo "Activate it, then run this again:"
    echo "    source .venv/bin/activate      # from the repository root"
    exit 1
fi
echo "Using $VIRTUAL_ENV"

echo "Running build for `uname -m` architecture"

#===============================================
# Clean-up
#===============================================
# build/ holds both the PyInstaller work directory and installer_version, which
# is regenerated below; removing the lot keeps a stale version out of the
# AppImage name.
rm -rf dist
rm -rf build

#===============================================
# Generate the version from the git commit count
#===============================================
# Writes python/build/installer_version, which the spec file reads. --print
# also writes it, so this is one call, not two.
VERSION=$(python ../tools/gen_version_build.py python --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating AppImage for version ${VERSION}"

#===============================================
# Run pyinstaller
#===============================================
pyinstaller -y packaging/marklens.spec
if [ $? -ne 0 ]; then
    echo "Running pyinstaller failed"
    exit 1
fi

if [ "$mode" = "app" ]; then
    echo "Built python/dist/marklens-py - run it with packaging/run_linux"
    exit 0
fi

#===============================================
# Assemble AppDir
#===============================================
APPDIR=dist/AppDir
rm -rf "$APPDIR"
mkdir -p "$APPDIR/usr/bin" \
         "$APPDIR/usr/share/applications" \
         "$APPDIR/usr/share/icons/hicolor/512x512/apps"

# Payload: the PyInstaller bundle directory.
cp -r dist/marklens-py "$APPDIR/usr/bin/"

# Desktop entry - appimagetool requires it at both the AppDir root and
# usr/share/applications.
cp packaging/marklens-py.desktop "$APPDIR/"
cp packaging/marklens-py.desktop "$APPDIR/usr/share/applications/"

# Icon - at the AppDir root under the name the desktop entry's Icon= field
# uses, and again in the hicolor theme.
ICON=../shared/icon-py.png
cp "$ICON" "$APPDIR/marklens-py.png"
cp "$ICON" "$APPDIR/usr/share/icons/hicolor/512x512/apps/marklens-py.png"

# AppRun launcher.
cp packaging/AppRun "$APPDIR/AppRun"
chmod +x "$APPDIR/AppRun"

#===============================================
# Build the AppImage
#===============================================
# $APPIMAGETOOL first, then PATH, then ~/bin, then packaging/tools at the
# repository root - the same four places, in the same order, that
# packaging/setup looks in, so a tool setup reported as "ok" is a tool this
# script can find. packaging/tools is where setup puts it when it downloads it
# itself; a copy at ~/bin still wins.
if [ -z "$APPIMAGETOOL" ]; then
    if command -v appimagetool >/dev/null 2>&1; then
        APPIMAGETOOL=$(command -v appimagetool)
    elif [ -x "$HOME/bin/appimagetool" ]; then
        APPIMAGETOOL="$HOME/bin/appimagetool"
    else
        APPIMAGETOOL="$(cd .. && pwd -P)/packaging/tools/appimagetool"
    fi
fi
if [ ! -x "$APPIMAGETOOL" ]; then
    echo "appimagetool not found at $APPIMAGETOOL"
    echo "Looked at \$APPIMAGETOOL, on PATH, in ~/bin, then packaging/tools/."
    echo
    echo "Run packaging/setup - it downloads it into packaging/tools/."
    echo "Or set APPIMAGETOOL=/path/to/appimagetool to use a copy of your own."
    exit 1
fi

ARCH=$(uname -m)
OUT="dist/Marklens-Python-${VERSION}-${ARCH}.AppImage"
ARCH=$ARCH "$APPIMAGETOOL" "$APPDIR" "$OUT"
if [ $? -ne 0 ]; then
    echo "appimagetool failed"
    exit 1
fi

echo "Built $OUT"
