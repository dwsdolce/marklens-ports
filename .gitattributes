# Line endings for the build scripts. Deliberately narrow rather than a blanket
# `* text=auto`, which would renormalise every file in the repository.
#
# A shell script with CRLF endings fails outright on Linux and macOS: the kernel
# reads the shebang as `/bin/bash` and reports "bad interpreter". Git on
# Windows will happily hand out CRLF unless told otherwise.
*/packaging/AppRun       text eol=lf
*/packaging/build_linux  text eol=lf
*/packaging/build_mac    text eol=lf
*/packaging/build_win    text eol=lf
*/packaging/setup        text eol=lf
*/packaging/run_linux    text eol=lf
*/packaging/run_mac      text eol=lf
*/packaging/run_win      text eol=lf
*.sh                     text eol=lf

# The Windows shells want the opposite.
*.bat text eol=crlf

# Keep GitHub's language statistics honest. shared/web holds the frontend
# assets copied verbatim from the Swift app - mermaid.min.js alone is 2.5 MB of
# minified JavaScript - and counting them makes a repository whose entire point
# is Python, C++ and Rust report itself as 88% JavaScript.
shared/web/* linguist-vendored
# Likewise the licence texts the Linux packages are obliged to carry.
shared/licenses/* linguist-vendored
