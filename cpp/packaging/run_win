#!/bin/bash
#
# Run the C++ port from the current source, building first if needed.
#
#   cpp/packaging/run_win [document.md] [args...]
#
# This is the tool for iterating on the code: it always runs what is in the
# working tree, never anything under dist/. Use packaging/build_win when you
# want the packaged artefact instead.

cd "$(dirname "$0")/.."

# Configure on first use, then build. cmake is cheap when nothing changed.
if [ ! -f build/CMakeCache.txt ]; then
    echo "Configuring build/ ..."
    cmake -B build || exit 1
fi

echo "Building ..."
cmake --build build --config Release || exit 1

# Visual Studio is a multi-config generator and puts the executable in a
# subdirectory; single-config generators put it straight in build/.
EXE=""
for candidate in build/Release/marklens-cpp.exe build/marklens-cpp.exe build/marklens-cpp; do
    [ -x "$candidate" ] && EXE="$candidate" && break
done
if [ -z "$EXE" ]; then
    echo "Built, but no executable found under build/"
    exit 1
fi

# A development build has no Qt beside it, so it exits silently with no window
# and no error unless the DLLs are reachable. Ask CMake which Qt it used:
# Qt6_DIR is <kit>/lib/cmake/Qt6, putting bin/ three levels up.
if ! command -v windeployqt.exe >/dev/null 2>&1; then
    qt6_dir=$(sed -n 's/^Qt6_DIR:PATH=//p' build/CMakeCache.txt 2>/dev/null | head -1)
    if [ -n "$qt6_dir" ] && [ "$qt6_dir" != "Qt6_DIR-NOTFOUND" ]; then
        qt_bin="$(dirname "$(dirname "$(dirname "$qt6_dir")")")/bin"
        if [ -d "$qt_bin" ]; then
            # CMake stores a Windows path; prepending "C:/..." to PATH splits it
            # on the drive-letter colon and quietly produces nonsense.
            command -v cygpath >/dev/null 2>&1 && qt_bin="$(cygpath -u "$qt_bin")"
            export PATH="$qt_bin:$PATH"
        fi
    fi
fi

echo "Running $EXE"
exec "./$EXE" "$@"
