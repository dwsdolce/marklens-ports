#!/bin/bash
#
# Build the Linux application bundle and an AppImage for the C++ port.
#
#   cpp/packaging/build_linux            # build, deploy and package
#   cpp/packaging/build_linux app        # build and deploy only, no AppImage
#   cpp/packaging/build_linux appimage   # the default, named explicitly
#   cpp/packaging/build_linux help
#
# Produces:
#   cpp/dist/                                       the staged application
#   cpp/dist/Marklens-Cpp-<version>-<arch>.AppImage
#
# Requires CMake, Qt 6 with WebEngineWidgets, md4c, Python 3, and linuxdeploy
# with its Qt plugin - packaging/setup downloads both into packaging/tools/ at
# the repository root, or set LINUXDEPLOY and LINUXDEPLOY_PLUGIN_QT to copies of
# your own. linuxdeploy is used rather than appimagetool
# directly because a Qt application needs its plugins, and QtWebEngine needs
# QtWebEngineProcess plus the Chromium resources, gathered first - which is
# exactly what the Qt plugin does. The Python port skips this because
# PyInstaller has already collected everything by that point.

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

mode="${1:-appimage}"
case "$mode" in
    help)
        echo "build_linux [app|appimage]"
        echo "  app       build and deploy into dist/, runnable in place"
        echo "  appimage  the above, plus an AppImage (default)"
        exit 0
        ;;
    app|appimage) ;;
    *)
        echo "Unknown mode: $mode"
        echo "build_linux [app|appimage]"
        exit 1
        ;;
esac

PYTHON="${PYTHON:-python3}"
BUILD_DIR=build-packaging
STAGE_DIR=dist
APPDIR="$STAGE_DIR/AppDir"

if ! command -v cmake >/dev/null 2>&1; then
    echo "cmake is not on PATH"
    exit 1
fi

echo "Running build for `uname -m` architecture"

#===============================================
# Clean-up
#===============================================
# build/ is deliberately left alone: cpp/README.md tells developers to configure
# there, and wiping their tree as a side effect of packaging would be rude.
rm -rf "$BUILD_DIR"
rm -rf "$STAGE_DIR"

#===============================================
# Generate the version from the git commit count
#===============================================
# --print also writes cpp/build/installer_version, so this is one call, not two.
VERSION=$("$PYTHON" ../tools/gen_version_build.py cpp --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating AppImage for version ${VERSION}"

#===============================================
# Configure and build
#===============================================
cmake -B "$BUILD_DIR" -S . \
    -DMARKLENS_FULL_VERSION="$VERSION"
if [ $? -ne 0 ]; then
    echo "Configuring failed"
    exit 1
fi

cmake --build "$BUILD_DIR" --config Release
if [ $? -ne 0 ]; then
    echo "Building failed"
    exit 1
fi

if [ "$mode" = "app" ]; then
    # Stage into dist/ directly. The AppImage path below installs into the
    # AppDir instead, so this needs its own install step rather than an early
    # exit - without it dist/ would be empty. Qt is not deployed in; the app
    # runs against the system Qt, which is what a developer wants and what
    # packaging/run_linux expects.
    cmake --install "$BUILD_DIR" --config Release --prefix "$STAGE_DIR"
    if [ $? -ne 0 ]; then
        echo "Installing to ${STAGE_DIR} failed"
        exit 1
    fi
    echo "Built $STAGE_DIR - run it with packaging/run_linux"
    exit 0
fi

#===============================================
# Assemble AppDir
#===============================================
# The executable and the shared assets go under usr/bin, side by side, because
# assets::sharedDir() looks for shared/ next to the executable.
mkdir -p "$APPDIR/usr/bin" \
         "$APPDIR/usr/share/applications" \
         "$APPDIR/usr/share/icons/hicolor/512x512/apps"

cmake --install "$BUILD_DIR" --config Release --prefix "$APPDIR/usr/bin"
if [ $? -ne 0 ]; then
    echo "Installing to the AppDir failed"
    exit 1
fi

# Desktop entry and icon - linuxdeploy needs both, and puts copies at the
# AppDir root itself.
cp packaging/marklens-cpp.desktop "$APPDIR/usr/share/applications/"

# The shared PNG is 512x512, which is what the directory it is staged into
# says it is - the icon theme spec expects the two to agree, and linuxdeploy
# enforces it. tools/make_icons.py is what keeps it that size.
cp ../shared/icon-cpp.png "$APPDIR/usr/share/icons/hicolor/512x512/apps/marklens-cpp.png"

# AppRun launcher. linuxdeploy would generate one, but ours exports the
# QtWebEngine sandbox setting that a relocated Chromium needs.
cp packaging/AppRun "$APPDIR/AppRun"
chmod +x "$APPDIR/AppRun"

#===============================================
# Build the AppImage
#===============================================
# The configured path first, then PATH, then ~/bin, then packaging/tools at the
# repository root - the same four places, in the same order, that
# packaging/setup looks in. They used to disagree: setup accepted a linuxdeploy
# on PATH and this script only ever looked at ~/bin, so setup could report "ok"
# for a tool the build then failed to find.
#
# packaging/tools is where setup puts them when it downloads them itself; a copy
# you installed at ~/bin still wins, so nothing gets used twice over.
TOOLS_DIR="$(cd .. && pwd -P)/packaging/tools"
find_tool() {
    if [ -n "$2" ]; then
        echo "$2"
    elif command -v "$1" >/dev/null 2>&1; then
        command -v "$1"
    elif [ -x "$HOME/bin/$1" ]; then
        echo "$HOME/bin/$1"
    else
        echo "$TOOLS_DIR/$1"
    fi
}
LINUXDEPLOY=$(find_tool linuxdeploy "$LINUXDEPLOY")
LINUXDEPLOY_PLUGIN_QT=$(find_tool linuxdeploy-plugin-qt "$LINUXDEPLOY_PLUGIN_QT")

# Both are AppImages downloaded from GitHub, and both have to be renamed: this
# script looks for the bare names, and linuxdeploy itself finds the plugin by
# looking for "linuxdeploy-plugin-qt" on PATH. The release assets are named
# with an architecture suffix, so an unrenamed download is never found.
if [ ! -x "$LINUXDEPLOY" ]; then
    echo "linuxdeploy not found at $LINUXDEPLOY"
    echo "Looked at \$LINUXDEPLOY, on PATH, in ~/bin, then packaging/tools/."
    echo
    echo "Run packaging/setup - it downloads both into packaging/tools/."
    echo "Or set LINUXDEPLOY=/path/to/linuxdeploy to use a copy of your own."
    exit 1
fi
if [ ! -x "$LINUXDEPLOY_PLUGIN_QT" ]; then
    echo "linuxdeploy-plugin-qt not found at $LINUXDEPLOY_PLUGIN_QT"
    echo "Looked at \$LINUXDEPLOY_PLUGIN_QT, on PATH, in ~/bin, then packaging/tools/."
    echo
    echo "Qt ships no linuxdeployqt; Qt support for linuxdeploy is this separate"
    echo "plugin, which is why there are two files rather than one."
    echo
    echo "Run packaging/setup - it downloads both into packaging/tools/."
    echo "Or set LINUXDEPLOY_PLUGIN_QT=/path/to/linuxdeploy-plugin-qt."
    exit 1
fi

# linuxdeploy finds the plugin on PATH, not by argument.
export PATH="$(dirname "$LINUXDEPLOY_PLUGIN_QT"):$PATH"

# Ask the build which Qt it actually used rather than guessing: Qt6_DIR in the
# cache is <kit>/lib/cmake/Qt6, so the kit is three levels up. build_win and
# build_mac read the same cache entry to locate windeployqt and macdeployqt.
#
# linuxdeploy resolves an ELF file's dependencies the way the dynamic linker
# does, so a Qt that is not in the linker's search path is invisible to it even
# though CMake linked against it happily - which is exactly the case for a Qt
# from the online installer, the tree under ~/Qt or /opt/Qt that CMakeLists.txt
# goes looking for. The symptom is "Could not find dependency:
# libQt6WebEngineWidgets.so.6". A Qt from a package manager is already on the
# default path, so this is a no-op there.
#
# QMAKE is separate: the qt plugin shells out to qmake to ask where this Qt
# keeps its plugins, QML imports and QtWebEngine resources. Left unset it takes
# the first qmake on PATH, which may be a different Qt or missing entirely.
qt6_dir=$(sed -n 's/^Qt6_DIR:PATH=//p' "$BUILD_DIR/CMakeCache.txt" 2>/dev/null | head -1)
if [ -n "$qt6_dir" ] && [ "$qt6_dir" != "Qt6_DIR-NOTFOUND" ]; then
    QT_KIT="$(dirname "$(dirname "$(dirname "$qt6_dir")")")"
    if [ -d "$QT_KIT/lib" ]; then
        echo "Deploying Qt from $QT_KIT"
        export LD_LIBRARY_PATH="$QT_KIT/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
    # qmake6 first: a distribution that ships both keeps the unsuffixed name
    # for Qt 5.
    if [ -z "$QMAKE" ]; then
        for candidate in "$QT_KIT/bin/qmake6" "$QT_KIT/bin/qmake"; do
            [ -x "$candidate" ] && QMAKE="$candidate" && break
        done
    fi
fi
if [ -z "$QMAKE" ]; then
    QMAKE=$(command -v qmake6 || command -v qmake)
fi
[ -n "$QMAKE" ] && export QMAKE

# Skip the Qt Positioning plugins, as build_win does.
#
# QtWebEngine links Qt Positioning for the Geolocation web API, so the qt
# plugin deploys the position plugins whether or not a Markdown viewer could
# ever call one. Among them is an NMEA GPS backend that links Qt SerialPort -
# an optional module the Qt installer does not select alongside Positioning -
# and linuxdeploy stops at "Could not find dependency: libQt6SerialPort.so.6"
# rather than pass over a plugin it cannot resolve. Where SerialPort is absent
# that plugin could not have loaded anyway, so there is nothing to lose by
# leaving it out. --exclude-library is not the answer: dependencies are
# resolved before the exclude list is consulted, so the error comes first.
#
# build_win drops these with windeployqt's --skip-plugin-types position. The qt
# plugin has no such option, and takes the plugin directory from `qmake -query`
# alone, so it is handed a mirror of that directory instead - symlinks to the
# real plugin types, with position/ left empty - through a wrapper that
# rewrites the one path in qmake's output. Every other path it queries still
# resolves to the real Qt.
if [ -n "$QMAKE" ]; then
    QT_PLUGINS=$("$QMAKE" -query QT_INSTALL_PLUGINS 2>/dev/null)
fi
if [ -n "$QT_PLUGINS" ] && [ -d "$QT_PLUGINS" ]; then
    MIRROR="$(pwd -P)/$BUILD_DIR/qt-plugins"
    rm -rf "$MIRROR"
    mkdir -p "$MIRROR/position"
    for plugin_type in "$QT_PLUGINS"/*; do
        [ -e "$plugin_type" ] || continue
        [ "$(basename "$plugin_type")" = position ] && continue
        ln -s "$plugin_type" "$MIRROR/"
    done

    # Written beside the mirror so the top-of-script rm -rf clears both.
    REAL_QMAKE="$QMAKE"
    QMAKE="$(pwd -P)/$BUILD_DIR/qmake-deploy"
    cat > "$QMAKE" <<EOF
#!/bin/bash
# Generated by packaging/build_linux - hides the position plugins from
# linuxdeploy-plugin-qt. Not a Qt tool; do not use it to build anything.
set -o pipefail
"$REAL_QMAKE" "\$@" | sed "s|^QT_INSTALL_PLUGINS:.*|QT_INSTALL_PLUGINS:$MIRROR|"
EOF
    chmod +x "$QMAKE"
    export QMAKE
fi

ARCH=$(uname -m)
OUT="$STAGE_DIR/Marklens-Cpp-${VERSION}-${ARCH}.AppImage"

# --custom-apprun keeps our launcher; without it the plugin overwrites AppRun.
ARCH=$ARCH OUTPUT="$OUT" "$LINUXDEPLOY" \
    --appdir "$APPDIR" \
    --executable "$APPDIR/usr/bin/marklens-cpp" \
    --desktop-file "$APPDIR/usr/share/applications/marklens-cpp.desktop" \
    --icon-file ../shared/icon-cpp.png \
    --icon-filename marklens-cpp \
    --custom-apprun packaging/AppRun \
    --plugin qt \
    --output appimage
if [ $? -ne 0 ]; then
    echo "linuxdeploy failed"
    exit 1
fi

echo "Built $OUT"
