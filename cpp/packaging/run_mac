#!/bin/zsh
#
# Run the C++ port from the current source, building first if needed.
#
#   cpp/packaging/run_mac [document.md] [args...]
#
# This is the tool for iterating on the code: it always runs what is in the
# working tree, never anything under dist/. Use packaging/build_mac when you
# want the packaged artefact instead.

cd "$(dirname "$0")/.."

if [ ! -f build/CMakeCache.txt ]; then
    echo "Configuring build/ ..."
    cmake -B build || exit 1
fi

echo "Building ..."
cmake --build build || exit 1

# The executable inside the bundle rather than `open`, which detaches and would
# lose the exit status and any stderr.
APP="build/Marklens C++.app/Contents/MacOS/Marklens C++"
if [ ! -x "$APP" ]; then
    echo "Built, but no executable at $APP"
    exit 1
fi

echo "Running $APP"
exec "$APP" "$@"
