#!/bin/bash
#
# Run the C++ port's tests against the current source, building first if needed.
#
#   cpp/packaging/test_linux [ctest args...]
#
# This is the tool for testing while working: it always tests what is in the
# working tree, never anything under dist/. Anything you pass is handed to
# ctest, so `packaging/test_linux -R core` selects a single test.
#
# It exists for the same reason run_linux does. The correct ctest invocation
# depends on the generator, and getting it wrong does not fail usefully - ctest
# reports "no tests were found" and exits, which reads like a broken checkout
# rather than a missing flag. Here the platform picks the flags.

cd "$(dirname "$0")/.."

if ! command -v cmake >/dev/null 2>&1; then
    echo "cmake is not on PATH. Run packaging/setup first."
    exit 1
fi

if [ ! -f build/CMakeCache.txt ]; then
    echo "Configuring build/ ..."
    cmake -B build || exit 1
fi

echo "Building ..."
cmake --build build || exit 1

# No -C: Makefiles and Ninja are single-config generators, and CMakeLists.txt
# has already defaulted CMAKE_BUILD_TYPE to Release for them, so there is only
# one configuration to test.
echo "Testing ..."
exec ctest --test-dir build --output-on-failure "$@"
