#!/bin/zsh
#
# Build the macOS application bundle and a disk image or installer package for
# the C++ port.
#
#   cpp/packaging/build_mac            # defaults to dmg
#   cpp/packaging/build_mac app        # build and deploy only, no disk image
#   cpp/packaging/build_mac dmg|pkg
#   cpp/packaging/build_mac help
#
# Produces:
#   cpp/dist/Marklens C++.app
#   cpp/Marklens_Cpp_V<version>.dmg   (or .pkg)
#
# Requires CMake, Qt 6 with WebEngineWidgets (brew install qt), md4c
# (brew install md4c), create-dmg for the dmg format (brew install create-dmg)
# and Python 3 for the version stamping.
#
# Signing and notarisation are opt-in, because an unsigned build is perfectly
# usable locally and this repository is public - no Developer ID is baked in:
#
#   export CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   export INSTALLER_IDENTITY="Developer ID Installer: Your Name (TEAMID)"
#   export NOTARY_PROFILE="notarytool-profile"

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

#===============================================
# Signing settings.
#===============================================
# Identity and notary profile live in one file outside every repository, so no
# Developer ID is baked into the source and there is a single place to edit it.
# Absent, the signing steps below detect the unset variables and the build goes
# unsigned - which is the right behaviour for anyone who is not the maintainer.
MACSIGN_ENV="${MACSIGN_ENV:-$HOME/.config/macsign.env}"
[[ -f "$MACSIGN_ENV" ]] && source "$MACSIGN_ENV"

if [[ $# == 0 ]]
then
    format="dmg"
elif [[ $# == 1 ]]
then
    if [[ "$1" == "help" ]]
    then
        echo "build_mac [app|dmg|pkg]"
        echo "  app  build and deploy into dist/, runnable in place"
        echo "  dmg  the above, plus a disk image (default)"
        echo "  pkg  the above, plus a signed installer package"
        exit 0
    fi
    format="$1"
    if [[ $format != "app" && $format != "dmg" && $format != "pkg" ]]
    then
        echo "Unknown format: $format"
        echo "build_mac [app|dmg|pkg]"
        exit 1
    fi
else
    echo "build_mac [app|dmg|pkg]"
    exit 1
fi

PYTHON="${PYTHON:-python3}"
BUILD_DIR=build-packaging
STAGE_DIR=dist
APP_NAME="Marklens C++"
# CMakeLists.txt finds Homebrew's Qt and md4c on its own, and packaging/setup
# will have built md4c into third_party/ if it was not already installed.
# Setting CMAKE_PREFIX_PATH is only an override for a Qt somewhere unusual.

if ! command -v cmake >/dev/null 2>&1; then
    echo "cmake is not on PATH (brew install cmake)"
    exit 1
fi

echo "Running build for `arch` architecture"

#===============================================
# Clean-up
#===============================================
# build/ is deliberately left alone: cpp/README.md tells developers to configure
# there, and wiping their tree as a side effect of packaging would be rude.
rm -rf "$BUILD_DIR"
rm -rf "$STAGE_DIR"

#===============================================
# Generate the version from the git commit count
#===============================================
# --print also writes cpp/build/installer_version, so this is one call, not two.
version=$("$PYTHON" ../tools/gen_version_build.py cpp --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating installer for version ${version}"

#===============================================
# Configure and build
#===============================================
cmake -B "$BUILD_DIR" -S . \
    -DMARKLENS_FULL_VERSION="$version"
if [ $? -ne 0 ]; then
    echo "Configuring failed"
    exit 1
fi

cmake --build "$BUILD_DIR" --config Release
if [ $? -ne 0 ]; then
    echo "Building failed"
    exit 1
fi

#===============================================
# Stage the bundle and its assets
#===============================================
cmake --install "$BUILD_DIR" --config Release --prefix "$STAGE_DIR"
if [ $? -ne 0 ]; then
    echo "Installing to ${STAGE_DIR} failed"
    exit 1
fi

#===============================================
# Deploy the Qt runtime into the bundle
#===============================================
# macdeployqt copies the Qt frameworks and plugins in and rewrites the install
# names, including QtWebEngineProcess.app and its Chromium resources.
MACDEPLOYQT=$(command -v macdeployqt)
if [ -z "$MACDEPLOYQT" ]; then
    # Ask the build which Qt it actually used rather than guessing: Qt6_DIR in
    # the cache is <prefix>/lib/cmake/Qt6, so macdeployqt is three levels up in
    # bin/. This also guarantees the deployment tool matches the Qt that built
    # the bundle, which scanning the environment does not.
    qt6_dir=$(sed -n 's/^Qt6_DIR:PATH=//p' "$BUILD_DIR/CMakeCache.txt" 2>/dev/null | head -1)
    if [ -n "$qt6_dir" ] && [ "$qt6_dir" != "Qt6_DIR-NOTFOUND" ]; then
        candidate="$(dirname "$(dirname "$(dirname "$qt6_dir")")")/bin/macdeployqt"
        [ -x "$candidate" ] && MACDEPLOYQT="$candidate"
    fi
fi
if [ -z "$MACDEPLOYQT" ]; then
    echo "macdeployqt not found next to the Qt that CMake used, nor on PATH."
    echo "Run packaging/setup to check the Qt installation."
    exit 1
fi

# Signing is opt-in; macdeployqt is asked to do it only when an identity is set,
# because its ad-hoc fallback confuses more than it helps.
if [[ -n "$CODESIGN_IDENTITY" ]]; then
    "$MACDEPLOYQT" "$STAGE_DIR/${APP_NAME}.app" -codesign="$CODESIGN_IDENTITY"
else
    "$MACDEPLOYQT" "$STAGE_DIR/${APP_NAME}.app"
fi
if [ $? -ne 0 ]; then
    echo "macdeployqt failed"
    exit 1
fi

#===============================================
# Repair the WebEngine helper's library paths
#===============================================
# macdeployqt writes some dependencies as @executable_path/../Frameworks/...,
# which resolves correctly for the main executable and not at all for
# QtWebEngineProcess, whose @executable_path is the helper's own MacOS
# directory. The helper then dies in dyld and the web view never renders,
# while the app itself starts normally - so this is invisible until a document
# is opened. The script rewrites those to @rpath, which works for both.
FIX_DEPS="$(cd "$(dirname "$0")/.." && pwd)/scripts/fix_bundle_deps.sh"
if [[ -x "$FIX_DEPS" ]]; then
    CODESIGN_IDENTITY="$CODESIGN_IDENTITY" "$FIX_DEPS" "$STAGE_DIR/${APP_NAME}.app" || exit 1
else
    echo "Missing ${FIX_DEPS} - the WebEngine helper will fail to load its"
    echo "libraries and no document will render."
    exit 1
fi

#===============================================
# Re-sign with the hardened runtime
#===============================================
# Two reasons the bundle has to be signed again here. macdeployqt signs without
# the hardened runtime and cannot be asked for one, which notarisation rejects
# with "The executable does not have the hardened runtime enabled". And
# fix_bundle_deps.sh has just rewritten load commands, which invalidates every
# signature it touched.
#
# Order matters: a bundle's signature covers the code nested inside it, so the
# innermost pieces are signed first and the app last. Signing the app first and
# a framework afterwards silently invalidates the app.
if [[ -n "$CODESIGN_IDENTITY" ]]; then
    echo "Re-signing with the hardened runtime"
    app_path="$STAGE_DIR/${APP_NAME}.app"
    webengine_fw="$app_path/Contents/Frameworks/QtWebEngineCore.framework"
    helper="$webengine_fw/Versions/A/Helpers/QtWebEngineProcess.app"

    # V8 allocates executable memory, which the hardened runtime forbids unless
    # the binary is entitled to it. Qt ships those exemptions beside the helper.
    # Signing without them produces a helper that notarises and then crashes as
    # soon as a page loads, so a missing file is fatal rather than a warning.
    if [[ -d "$helper" ]]; then
        entitlements="$helper/Contents/Resources/QtWebEngineProcess.entitlements"
        if [[ ! -f "$entitlements" ]]; then
            echo "Missing ${entitlements}"
            echo "Without it the helper is signed with no JIT exemption and the"
            echo "web view crashes as soon as it loads a page."
            exit 1
        fi
        /usr/bin/codesign --force --timestamp --options runtime \
            --entitlements "$entitlements" \
            --sign "$CODESIGN_IDENTITY" "$helper" || exit 1
    fi

    # Everything else nested in the bundle, deepest path first so that a
    # framework is sealed only after the code inside it has been.
    while IFS= read -r item; do
        [[ "$item" == "$helper"* ]] && continue
        /usr/bin/codesign --force --timestamp --options runtime \
            --sign "$CODESIGN_IDENTITY" "$item" || exit 1
    done < <(
        {
            find "$app_path/Contents" -type d -name '*.framework'
            find "$app_path/Contents" -type f \( -name '*.dylib' -o -name '*.so' \)
        } | awk '{ print gsub(/\//, "/"), $0 }' | sort -rn | cut -d' ' -f2-
    )

    /usr/bin/codesign --force --timestamp --options runtime \
        --sign "$CODESIGN_IDENTITY" "$app_path" || exit 1

    # Catches a broken seal here, where the message names the part that failed,
    # rather than at the notary service, which takes minutes to say less.
    if ! /usr/bin/codesign --verify --deep --strict "$app_path"; then
        echo "The re-signed bundle does not verify"
        exit 1
    fi
fi

if [[ $format == "app" ]]; then
    echo "Built dist/${APP_NAME}.app - run it with packaging/run_mac"
    exit 0
fi

#===============================================
# Create the format.
#===============================================
echo "Creating the ${format}"
installer_name="Marklens_Cpp_V${version}.${format}"
test -f $installer_name && rm $installer_name

if [[ $format == "dmg" ]]
then
    create-dmg \
        --volname "${APP_NAME} $version Install" \
        --window-pos 1 1 \
        --window-size 640 400 \
        --icon-size 110 \
        --icon "${APP_NAME}.app" 160 180 \
        --app-drop-link 460 180 \
        --hide-extension "${APP_NAME}.app" \
        --format ULFO \
        --volicon "../shared/icon-cpp.icns" \
        $installer_name \
        "${STAGE_DIR}/"
else
    if [[ -z "$INSTALLER_IDENTITY" ]]; then
        echo "INSTALLER_IDENTITY is not set - a pkg cannot be built unsigned"
        echo "Set it, or build a dmg instead: packaging/build_mac dmg"
        exit 1
    fi
    rm -rf packages
    mkdir packages
    pkgbuild --root "./${STAGE_DIR}" \
        --identifier "solutions.ddj.marklens.cpp" \
        --version "${version}" \
        --install-location "/Applications" \
        packages/MarklensCpp.pkg
    productbuild --package-path ./packages \
        --package packages/MarklensCpp.pkg \
        --sign "$INSTALLER_IDENTITY" \
        $installer_name
fi
if [ $? -ne 0 ]; then
    echo "Creating the ${format} failed"
    exit 1
fi

#===============================================
# Sign, notarize and staple - all skipped when unconfigured.
#===============================================
if [[ -z "$CODESIGN_IDENTITY" ]]; then
    echo "CODESIGN_IDENTITY is not set - leaving ${installer_name} unsigned."
    echo "Gatekeeper will warn on first launch; right-click > Open to bypass."
    echo "Done creating ${installer_name}"
    exit 0
fi

if [[ $format == "dmg" ]]
then
    echo "Signing the ${format}"
    /usr/bin/codesign -s "$CODESIGN_IDENTITY" $installer_name
    if [ $? -ne 0 ]; then
        echo "Signing the ${format} failed"
        exit 1
    fi
fi

if [[ -z "$NOTARY_PROFILE" ]]; then
    echo "NOTARY_PROFILE is not set - skipping notarisation."
    echo "Done creating ${installer_name}"
    exit 0
fi

echo "Notarizing the ${format}"
# notarytool exits 0 when Apple answers, not when Apple approves: a rejected
# submission still returns success and prints "status: Invalid". Checking only
# the exit status therefore carries on to stapling, which fails with a CloudKit
# "Record not found" that says nothing about the real problem. The verdict is
# read out of the output instead, and the log - which names the offending
# binaries - is fetched before giving up.
notary_output=$(xcrun notarytool submit $installer_name --wait --keychain-profile "$NOTARY_PROFILE" 2>&1)
notary_status=$?
echo "$notary_output"
if [ $notary_status -ne 0 ]; then
    echo "Notarizing the ${format} failed"
    exit 1
fi
if ! echo "$notary_output" | grep -q "status: Accepted"; then
    echo "Notarisation did not succeed - fetching the log"
    submission_id=$(echo "$notary_output" | awk '/id: /{print $2; exit}')
    if [[ -n "$submission_id" ]]; then
        xcrun notarytool log "$submission_id" --keychain-profile "$NOTARY_PROFILE"
    fi
    exit 1
fi

echo "Stapling the ${format}"
xcrun stapler staple $installer_name
if [ $? -ne 0 ]; then
    echo "Stapling the ${format} failed"
    exit 1
fi

echo "Done creating ${installer_name}"
