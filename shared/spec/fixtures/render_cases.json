{
  "_comment": "Markdown -> HTML contract. Assertions are tolerant substrings so any conformant GFM engine can pass: assert that a <table> exists, not its exact attributes. `contains` must all be present in the rendered HTML; `absent` must none be. Rendering here means the body transform (incl. mermaid rewrite), before the HTML shell is wrapped around it.",
  "cases": [
    {
      "name": "heading",
      "md": "# Hello World",
      "contains": ["<h1", "Hello World", "</h1>"],
      "absent": []
    },
    {
      "name": "emphasis",
      "md": "This is **bold** and *italic*.",
      "contains": ["<strong>bold</strong>", "<em>italic</em>"],
      "absent": []
    },
    {
      "name": "inline code",
      "md": "Use `printf` here.",
      "contains": ["<code>printf</code>"],
      "absent": []
    },
    {
      "name": "fenced code with language",
      "md": "```swift\nlet x = 1\n```",
      "contains": ["<pre>", "<code", "language-swift", "let x = 1"],
      "absent": []
    },
    {
      "name": "gfm table",
      "md": "| A | B |\n|---|---|\n| 1 | 2 |",
      "contains": ["<table>", "<th>A</th>", "<td>1</td>"],
      "absent": []
    },
    {
      "name": "gfm strikethrough",
      "md": "~~gone~~",
      "contains": ["<del>gone</del>"],
      "absent": []
    },
    {
      "name": "gfm task list",
      "md": "- [x] done\n- [ ] todo",
      "contains": ["type=\"checkbox\"", "checked", "done", "todo"],
      "absent": []
    },
    {
      "name": "relative link preserved",
      "md": "See [inventory](INVENTORY.md).",
      "contains": ["href=\"INVENTORY.md\"", "inventory"],
      "absent": []
    },
    {
      "name": "relative image preserved",
      "md": "![icon](design/icon.svg)",
      "contains": ["<img", "src=\"design/icon.svg\"", "alt=\"icon\""],
      "absent": ["marklens-doc"]
    },
    {
      "name": "mermaid block rewritten to div",
      "md": "```mermaid\ngraph TD; A-->B;\n```",
      "contains": ["<div class=\"mermaid\">", "graph TD", "A-->B"],
      "absent": ["language-mermaid", "&gt;&gt;", "<code"]
    },
    {
      "name": "non-mermaid code block untouched",
      "md": "```js\na > b\n```",
      "contains": ["<pre>", "<code", "language-js"],
      "absent": ["class=\"mermaid\""]
    },
    {
      "name": "blockquote",
      "md": "> quoted",
      "contains": ["<blockquote>", "quoted"],
      "absent": []
    }
  ]
}