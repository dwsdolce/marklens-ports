{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marklens",
  "version": "0.1.0",
  "identifier": "solutions.ddj.marklens.rust",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Marklens",
        "width": 900,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
