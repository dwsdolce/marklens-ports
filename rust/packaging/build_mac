#!/bin/zsh
#
# Build the macOS application bundle and a disk image for the Rust port.
#
#   rust/packaging/build_mac            # defaults to dmg
#   rust/packaging/build_mac dmg|app
#   rust/packaging/build_mac help
#
# Produces:
#   rust/src-tauri/target/release/bundle/macos/Marklens Rust.app
#   rust/Marklens_Rust_V<version>.dmg   (unless "app" was asked for)
#
# Requires Rust (rustup), the Tauri CLI (cargo install tauri-cli
# --version "^2.0") and Python 3 for the version stamping. Tauri builds the
# disk image itself, so create-dmg is not needed here as it is for the other
# two ports.
#
# Signing and notarisation are opt-in, because an unsigned build is perfectly
# usable locally and this repository is public - no Developer ID is baked in.
# Two sets of names are read, because two things are signed.
#
# Tauri's own bundler signs the .app, with the hardened runtime, and notarises
# and staples it:
#
#   export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   export APPLE_KEYCHAIN_PROFILE="notarytool-profile"
#
# None of that touches the disk image, which Tauri builds around the finished
# app. This script signs, notarises and staples the image itself, using the
# same names as the C++ and Python ports so that all three read one settings
# file and produce the same shape of artefact:
#
#   export CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   export NOTARY_PROFILE="notarytool-profile"
#
# The image therefore makes a second trip to the notary service. That is the
# price of shipping an image whose ticket is stapled as well as an app whose
# ticket is stapled; either alone leaves a first launch depending on Apple
# being reachable.

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

#===============================================
# Signing settings.
#===============================================
# Identity and notary profile live in one file outside every repository, so no
# Developer ID is baked into the source and there is a single place to edit it.
# Absent, the signing steps below detect the unset variables and the build goes
# unsigned - which is the right behaviour for anyone who is not the maintainer.
MACSIGN_ENV="${MACSIGN_ENV:-$HOME/.config/macsign.env}"
[[ -f "$MACSIGN_ENV" ]] && source "$MACSIGN_ENV"

if [[ $# == 0 ]]
then
    format="dmg"
elif [[ $# == 1 ]]
then
    if [[ "$1" == "help" ]]
    then
        echo "build_mac [dmg|app]"
        exit 0
    fi
    format="$1"
    if [[ $format != "dmg" && $format != "app" ]]
    then
        echo "Unknown installer format: $format"
        echo "build_mac [dmg|app]"
        exit 1
    fi
else
    echo "build_mac [dmg|app]"
    exit 1
fi

PYTHON="${PYTHON:-python3}"

if ! command -v cargo >/dev/null 2>&1; then
    echo "cargo is not on PATH - install Rust from https://rustup.rs"
    exit 1
fi
if ! cargo tauri --version >/dev/null 2>&1; then
    echo "The Tauri CLI is not installed"
    echo "Run: cargo install tauri-cli --version \"^2.0\""
    exit 1
fi

echo "Running build for `arch` architecture"

#===============================================
# Clean-up
#===============================================
# The cargo target directory is deliberately left alone - a full rebuild of the
# Tauri dependency tree costs minutes and nothing in it goes stale between
# packaging runs. Only the bundle output is cleared.
rm -rf src-tauri/target/release/bundle

#===============================================
# Generate the version from the git commit count
#===============================================
# The bundle itself carries the three-part version from tauri.conf.json, which
# Tauri requires to be valid semver; the fourth component is the build number
# and appears in the image file name, matching the other two ports.
version=$("$PYTHON" ../tools/gen_version_build.py rust --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating installer for version ${version}"

#===============================================
# Build and bundle
#===============================================
(cd src-tauri && cargo tauri build --bundles "$format")
if [ $? -ne 0 ]; then
    echo "cargo tauri build failed"
    exit 1
fi

if [[ $format == "app" ]]; then
    echo "Built src-tauri/target/release/bundle/macos/Marklens Rust.app"
    exit 0
fi

#===============================================
# Collect the image under the shared naming convention
#===============================================
built=$(ls src-tauri/target/release/bundle/dmg/*.dmg 2>/dev/null | head -1)
if [[ -z "$built" ]]; then
    echo "No disk image was produced under src-tauri/target/release/bundle/dmg"
    exit 1
fi

installer_name="Marklens_Rust_V${version}.dmg"
test -f $installer_name && rm $installer_name
cp "$built" "$installer_name"
if [ $? -ne 0 ]; then
    echo "Copying the image failed"
    exit 1
fi

#===============================================
# Sign, notarize and staple - all skipped when unconfigured.
#===============================================
# Tauri has already signed the .app from APPLE_SIGNING_IDENTITY, and notarised
# and stapled it if it was given notary credentials. None of that reaches the
# disk image: Tauri builds the image around the app and leaves the image itself
# unsigned and unstapled. The C++ and Python ports sign, notarise and staple
# the image they ship, so the same is done here - the image is what a user
# downloads, and a ticket stapled to it is what lets Gatekeeper clear it
# without a round trip to Apple.
if [[ -z "$CODESIGN_IDENTITY" ]]; then
    echo "CODESIGN_IDENTITY is not set - leaving ${installer_name} unsigned."
    echo "Gatekeeper will warn on first launch; right-click > Open to bypass."
    echo "Done creating ${installer_name}"
    exit 0
fi

echo "Signing the ${format}"
# --force, unlike the other two ports, because Tauri has already signed the
# image it produced and codesign refuses an existing signature otherwise
# ("is already signed"). The other two build their image with create-dmg,
# which leaves it unsigned. Re-signing with the same identity is a no-op in
# effect and keeps the step honest if Tauri ever stops signing it.
/usr/bin/codesign --force -s "$CODESIGN_IDENTITY" $installer_name
if [ $? -ne 0 ]; then
    echo "Signing the ${format} failed"
    exit 1
fi

if [[ -z "$NOTARY_PROFILE" ]]; then
    echo "NOTARY_PROFILE is not set - skipping notarisation."
    echo "Done creating ${installer_name}"
    exit 0
fi

echo "Notarizing the ${format}"
# notarytool exits 0 when Apple answers, not when Apple approves: a rejected
# submission still returns success and prints "status: Invalid". Checking only
# the exit status therefore carries on to stapling, which fails with a CloudKit
# "Record not found" that says nothing about the real problem. The verdict is
# read out of the output instead, and the log - which names the offending
# binaries - is fetched before giving up.
notary_output=$(xcrun notarytool submit $installer_name --wait --keychain-profile "$NOTARY_PROFILE" 2>&1)
notary_status=$?
echo "$notary_output"
submission_id=$(echo "$notary_output" | awk '/id: /{print $2; exit}')

# Losing the connection while polling is not a failed submission. The upload
# has already happened and Apple keeps processing regardless, so a dropped
# request here - "The request timed out", which is routine on a slow link and
# a large image - used to throw away a build that had in fact been accepted.
# Rejoin the wait instead; notarytool wait prints the same verdict line.
if [ $notary_status -ne 0 ] && [[ -n "$submission_id" ]]; then
    echo "Lost contact while waiting - rejoining submission ${submission_id}"
    notary_output=$(xcrun notarytool wait "$submission_id" --keychain-profile "$NOTARY_PROFILE" 2>&1)
    notary_status=$?
    echo "$notary_output"
fi

if [ $notary_status -ne 0 ]; then
    echo "Notarizing the ${format} failed"
    if [[ -n "$submission_id" ]]; then
        echo "The submission may still be processing. Check it with:"
        echo "  xcrun notarytool info $submission_id --keychain-profile $NOTARY_PROFILE"
        echo "and if it was accepted, staple without rebuilding:"
        echo "  xcrun stapler staple $installer_name"
    fi
    exit 1
fi
if ! echo "$notary_output" | grep -q "status: Accepted"; then
    echo "Notarisation did not succeed - fetching the log"
    if [[ -n "$submission_id" ]]; then
        xcrun notarytool log "$submission_id" --keychain-profile "$NOTARY_PROFILE"
    fi
    exit 1
fi

echo "Stapling the ${format}"
xcrun stapler staple $installer_name
if [ $? -ne 0 ]; then
    echo "Stapling the ${format} failed"
    exit 1
fi

echo "Done creating ${installer_name}"
