#!/bin/bash
#
# Build the Linux packages for the Rust port.
#
#   rust/packaging/build_linux                 # AppImage and .deb
#   rust/packaging/build_linux app             # build only, no packages
#   rust/packaging/build_linux appimage|deb|rpm
#
# Produces (under rust/dist/):
#   Marklens-Rust-<version>-<arch>.AppImage
#   Marklens-Rust-<version>-<arch>.deb
#
# Requires Rust (rustup), the Tauri CLI (cargo install tauri-cli
# --version "^2.0"), Python 3 for the version stamping, and the webview
# development packages, e.g. on Debian/Ubuntu:
#
#   sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file \
#                    libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev
#
# Tauri bundles the AppImage itself, so unlike the other two ports there is no
# appimagetool or linuxdeploy to install separately: the frontend is embedded
# in the binary and the only external dependency is the system webview.

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

PYTHON="${PYTHON:-python3}"

if [ $# -gt 1 ]; then
    echo "build_linux [app|appimage|deb|rpm]"
    exit 1
fi
if [ "$1" = "help" ]; then
    echo "build_linux [app|appimage|deb|rpm]"
    echo "  app  build the executable only, runnable with packaging/run_linux"
    echo "  the rest are bundle formats; the default is appimage,deb,rpm"
    exit 0
fi
# Tauri writes the .rpm with a Rust implementation of the format rather than by
# shelling out, so unlike the other two ports this one needs no rpmbuild.
BUNDLES="${1:-appimage,deb,rpm}"

if ! command -v cargo >/dev/null 2>&1; then
    echo "cargo is not on PATH - install Rust from https://rustup.rs"
    exit 1
fi
# The CLI is only needed for bundling; `app` mode is plain cargo.
if [ "$BUNDLES" != "app" ] && ! cargo tauri --version >/dev/null 2>&1; then
    echo "The Tauri CLI is not installed"
    echo "Run: cargo install tauri-cli --version \"^2.0\""
    exit 1
fi

echo "Running build for `uname -m` architecture"

#===============================================
# Clean-up
#===============================================
# The cargo target directory is deliberately left alone - a full rebuild of the
# Tauri dependency tree costs minutes and nothing in it goes stale between
# packaging runs. Only the bundle output is cleared.
rm -rf src-tauri/target/release/bundle
rm -rf dist
mkdir -p dist

#===============================================
# Generate the version from the git commit count
#===============================================
# The package file names carry the four-part version, matching the other two
# ports. What goes *inside* the .deb and .rpm has to be valid semver, because
# Tauri validates it, so 0.1.0.31 becomes 0.1.0+31 - the build number as semver
# build metadata.
#
# This used to be left at the three-part version from tauri.conf.json, on the
# grounds that the build number was visible in the file name. That made every
# build declare 0.1.0, and a package whose version never changes cannot be
# upgraded: dpkg and rpm compare the version field and nothing else, so
# installing a new build over an old one was treated as a reinstall. Both order
# 0.1.0+31 after 0.1.0+30 and after a plain 0.1.0, so an existing install
# upgrades too.
VERSION=$("$PYTHON" ../tools/gen_version_build.py rust --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
BUNDLE_VERSION="${VERSION%.*}+${VERSION##*.}"
echo "Creating packages for version ${VERSION} (bundles declare ${BUNDLE_VERSION})"

if [ "$BUNDLES" = "app" ]; then
    (cd src-tauri && cargo build --release)
    if [ $? -ne 0 ]; then
        echo "cargo build failed"
        exit 1
    fi
    echo "Built src-tauri/target/release/marklens-rust"
    echo "Run it with packaging/run_linux"
    exit 0
fi

#===============================================
# Build and bundle
#===============================================
# --config overrides the version for this build only, so tauri.conf.json keeps
# the plain semver it is meant to hold and nothing has to be edited or restored
# around a build.
(cd src-tauri && cargo tauri build \
    --config "{\"version\":\"$BUNDLE_VERSION\"}" \
    --bundles "$BUNDLES")
if [ $? -ne 0 ]; then
    echo "cargo tauri build failed"
    exit 1
fi

#===============================================
# Collect the packages under the shared naming convention
#===============================================
ARCH=$(uname -m)
found=0
for kind in appimage deb rpm; do
    for built in src-tauri/target/release/bundle/$kind/*.$kind \
                 src-tauri/target/release/bundle/$kind/*.AppImage; do
        [ -f "$built" ] || continue
        case "$built" in
            *.AppImage) out="dist/Marklens-Rust-${VERSION}-${ARCH}.AppImage" ;;
            *)          out="dist/Marklens-Rust-${VERSION}-${ARCH}.${kind}" ;;
        esac
        cp "$built" "$out" && echo "Built $out"
        found=1
    done
done

if [ $found -eq 0 ]; then
    echo "No packages were produced under src-tauri/target/release/bundle"
    exit 1
fi
