#!/bin/zsh
#
# Run the Rust port from the current source, building first if needed.
#
#   rust/packaging/run_mac [document.md] [args...]
#
# This is the tool for iterating on the code: `cargo run` rebuilds whatever
# changed and runs it. A debug build, because that is what iterating wants;
# packaging/build_mac produces the optimised artefact.

cd "$(dirname "$0")/.."

if ! command -v cargo >/dev/null 2>&1; then
    echo "cargo is not on PATH. Run packaging/setup first."
    exit 1
fi

cd src-tauri
exec cargo run -- "$@"
