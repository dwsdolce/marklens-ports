#!/bin/bash
#
# Build the Windows installer for the Rust port.
#
#   rust/packaging/build_win
#
# Produces:
#   rust/installer/Marklens_Rust_V<version>.exe
#
# Runs under Cygwin or Git Bash. Requires Rust (rustup), the Tauri CLI
# (cargo install tauri-cli --version "^2.0") and Python 3 for the icon and
# version stamping. The MSVC build tools have to be installed; the WebView2
# runtime does not - the NSIS installer carries its bootstrapper.
#
# Unlike the other two ports this does not drive Inno Setup. Tauri's own
# bundler builds the NSIS installer, and it is the only one of the three that
# knows how to detect and install the WebView2 runtime the app cannot start
# without. The output is renamed to match the other ports so a release
# directory reads consistently.

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

PYTHON="${PYTHON:-python}"

if ! command -v cargo >/dev/null 2>&1; then
    echo "cargo is not on PATH - install Rust from https://rustup.rs"
    exit 1
fi
if ! cargo tauri --version >/dev/null 2>&1; then
    echo "The Tauri CLI is not installed"
    echo "Run: cargo install tauri-cli --version \"^2.0\""
    exit 1
fi

echo "Running build for $(uname -m) architecture"

#===============================================
# Clean-up
#===============================================
# The cargo target directory is deliberately left alone - a full rebuild of the
# Tauri dependency tree costs minutes and nothing in it goes stale between
# packaging runs. Only the bundle output is cleared.
rm -rf src-tauri/target/release/bundle
rm -rf installer
mkdir -p installer

#===============================================
# Generate the Windows icon from the shared PNG
#===============================================
# Tauri picks the .ico out of bundle.icon for the executable and the installer.
"$PYTHON" ../tools/make_ico.py ../shared/icon.png src-tauri/icons/icon.ico
if [ $? -ne 0 ]; then
    echo "Generating the icon failed"
    exit 1
fi

#===============================================
# Generate the version from the git commit count
#===============================================
# The bundle itself carries the three-part version from tauri.conf.json, which
# Tauri requires to be valid semver; the fourth component is the build number
# and appears in the installer file name, matching the other two ports.
# --print also writes rust/build/installer_version, so this is one call.
version=$("$PYTHON" ../tools/gen_version_build.py rust --print)
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating installer for version ${version}"

#===============================================
# Build and bundle
#===============================================
# NSIS only: the MSI target needs WiX downloaded separately and offers nothing
# here that NSIS does not.
(cd src-tauri && cargo tauri build --bundles nsis)
if [ $? -ne 0 ]; then
    echo "cargo tauri build failed"
    exit 1
fi

#===============================================
# Collect the installer under the shared naming convention
#===============================================
built=$(ls src-tauri/target/release/bundle/nsis/*-setup.exe 2>/dev/null | head -1)
if [ -z "$built" ]; then
    echo "No NSIS installer was produced under src-tauri/target/release/bundle/nsis"
    exit 1
fi

out="installer/Marklens_Rust_V${version}.exe"
cp "$built" "$out"
if [ $? -ne 0 ]; then
    echo "Copying the installer failed"
    exit 1
fi

echo "Installer created successfully: rust/${out}"
