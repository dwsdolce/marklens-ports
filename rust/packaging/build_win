#!/bin/bash
#
# Build the Windows installer for the Rust port.
#
#   rust/packaging/build_win              # build and package
#   rust/packaging/build_win app          # build only, no installer
#   rust/packaging/build_win installer    # the default, named explicitly
#   rust/packaging/build_win help
#
# Produces:
#   rust/installer/Marklens_Rust_V<version>.exe
#
# Runs under Cygwin or Git Bash. Requires Rust (rustup), Inno Setup 6 and
# Python 3 for the icon and version stamping. The MSVC build tools have to be
# installed; the WebView2 runtime does not - the installer downloads Microsoft's
# bootstrapper if the runtime is absent.
#
# Inno Setup, like the other two ports, rather than Tauri's own NSIS bundler.
# The bundler installed WebView2 for us, but its version must be three-part
# semver, so the build number never reached the installer and every build looked
# like the same version to it - which meant it could never offer to replace an
# existing install. packaging/marklens-rust.iss explains the trade in full.
# macOS and Linux still use Tauri's bundler, where its .dmg, .deb and .rpm
# output has no equivalent here.

# Run from the port's root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

mode="${1:-installer}"
case "$mode" in
    help)
        echo "build_win [app|installer]"
        echo "  app        build the executable only, runnable with packaging/run_win"
        echo "  installer  the above, bundled into an installer (default)"
        exit 0
        ;;
    app|installer) ;;
    *)
        echo "Unknown mode: $mode"
        echo "build_win [app|installer]"
        exit 1
        ;;
esac

PYTHON="${PYTHON:-python}"

if ! command -v cargo >/dev/null 2>&1; then
    echo "cargo is not on PATH - install Rust from https://rustup.rs"
    exit 1
fi
# The Tauri CLI is not needed on Windows any more: cargo builds the executable
# and Inno Setup packages it. It is still what builds the macOS and Linux
# bundles, so packaging/setup goes on installing it.

echo "Running build for $(uname -m) architecture"

#===============================================
# Clean-up
#===============================================
# The cargo target directory is deliberately left alone - a full rebuild of the
# Tauri dependency tree costs minutes and nothing in it goes stale between
# packaging runs. Only the installer output is cleared.
rm -rf installer
mkdir -p installer

#===============================================
# Generate the version from the git commit count
#===============================================
# Four-part, as the other two ports use: the Inno script reads
# rust/build/installer_version and puts the whole thing in the installer name,
# the version resource and the Add/Remove Programs entry. tauri.conf.json keeps
# its own three-part semver, which is all Tauri will accept and all the macOS
# and Linux bundles need. --print also writes the file, so this is one call.
# tr: belt and braces. This value becomes a file name, and a stray carriage
# return from a Windows text-mode stdout would land inside it - $(...)
# strips trailing newlines but not the CR that precedes them.
version=$("$PYTHON" ../tools/gen_version_build.py rust --print | tr -d "
")
if [ $? -ne 0 ]; then
    echo "Generating the version failed"
    exit 1
fi
echo "Creating installer for version ${version}"

if [ "$mode" = "app" ]; then
    # Plain cargo: no bundler, so no NSIS download and no installer. The
    # frontend is embedded in the binary, so this is complete on its own.
    (cd src-tauri && cargo build --release)
    if [ $? -ne 0 ]; then
        echo "cargo build failed"
        exit 1
    fi
    echo "Built src-tauri/target/release/marklens-rust.exe"
    echo "Run it with packaging/run_win"
    exit 0
fi

#===============================================
# Build the executable
#===============================================
# One self-contained binary: the frontend is embedded at compile time and the
# webview is the operating system's, so there is nothing to stage beside it.
(cd src-tauri && cargo build --release)
if [ $? -ne 0 ]; then
    echo "cargo build failed"
    exit 1
fi

#===============================================
# Prepare installer path
#===============================================
# ISCC is a native Windows program, so it needs a Windows path. cygpath is
# present in both Cygwin and Git Bash.
installer_file=$(cygpath -w "$(pwd)/packaging/marklens-rust.iss")
ISCC_PATH="C:/Program Files (x86)/Inno Setup 6/ISCC.exe"

if [ ! -f "$ISCC_PATH" ]; then
    echo "Inno Setup 6 not found at ${ISCC_PATH}"
    echo "Install it from https://jrsoftware.org/isdl.php"
    exit 1
fi

#===============================================
# Build the installer
#===============================================
# No /D argument: the script reads build/installer_version itself. Git Bash
# rewrites arguments that look like Unix paths and Cygwin does not, so a
# command-line define cannot be written to work in both shells.
"$ISCC_PATH" "$installer_file"
if [ $? -ne 0 ]; then
    echo "Creating the installer failed"
    exit 1
fi

echo "Installer created successfully: rust/installer/Marklens_Rust_V${version}.exe"
