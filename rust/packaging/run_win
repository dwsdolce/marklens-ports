#!/bin/bash
#
# Run the Rust port, whichever way it was built.
#
#   rust/packaging/run_win [document.md] [args...]
#
# The counterpart of run_mac and run_linux, and of the same script in the other
# two ports: one command shape everywhere.
#
# The frontend is embedded in the binary and the webview comes from the OS, so
# unlike the C++ port there is nothing to deploy alongside it - a release build
# runs as-is. `cargo run` is the fallback, which also builds if needed.

cd "$(dirname "$0")/.."

for candidate in src-tauri/target/release/marklens-rust.exe \
                 src-tauri/target/debug/marklens-rust.exe; do
    if [ -x "$candidate" ]; then
        exec "./$candidate" "$@"
    fi
done

if command -v cargo >/dev/null 2>&1; then
    echo "No build found - building and running with cargo."
    cd src-tauri && exec cargo run --release -- "$@"
fi

echo "No build found and cargo is not on PATH. Run packaging/setup first."
exit 1
