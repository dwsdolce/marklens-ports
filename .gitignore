# Python
python/.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# C++/Qt
cpp/build/
cpp/*.pro.user

# Rust/Tauri
rust/target/
rust/src-tauri/target/
node_modules/

.DS_Store

# PyInstaller output
python/dist/
python/build_pyi/

# Rust
rust/src-tauri/target/
rust/src-tauri/gen/

# Packaging output (see packaging/README.md)
*/installer/
python/build/
# build_mac writes the disk image and package next to the port itself.
*.dmg
*.pkg

# Downloaded by packaging/setup: linuxdeploy, its Qt plugin, appimagetool.
# Fetched rather than committed for the same reason cpp/third_party/md4c is.
packaging/tools/
python/dist/
cpp/build-packaging/
cpp/dist/
rust/build/
rust/dist/

# The per-port icons (shared/icon-{cpp,py,rust}.{png,ico,icns}) are committed
# artwork, not build output: tauri-build reads its .ico at compile time, and
# committing them means building a port needs neither Inkscape nor PySide6.
# tools/make_icons.py regenerates them when shared/icon.svg changes.
build/icon-plate-*.png
# Stamped by tools/gen_version_build.py so a frozen app can report its
# build number without git.
python/src/marklens/version_build

# packaging/setup builds md4c here (see cpp/packaging/setup)
cpp/third_party/
